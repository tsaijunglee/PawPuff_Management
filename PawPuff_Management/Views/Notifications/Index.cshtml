@{
    ViewData["Title"] = "發送通知";
    ViewData["CurrentScreen"] = "send-notification";
}

<div class="dashboard-content management-screen" id="managementScreen" data-screen-panel="management">
    <section class="soft-panel management-panel">
        <span class="screen-kicker">
            <span class="tiny-paw" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
            PawPuff Admin
        </span>
        <h2 class="screen-title" id="managementTitle">發送通知</h2>
        <p class="screen-desc" id="managementDescription">
            建立並發送站內通知給指定會員或會員群組。
        </p>
        <div class="send-notification-view" id="sendNotificationView">
            <form class="send-notification-form"
                  id="sendNotificationForm"
                  data-send-url="@Url.Action("Send", "Notifications")"
                  novalidate>
                @Html.AntiForgeryToken()

                <div class="send-notification-card">
                    <div class="send-notification-grid">
                        <div class="send-notification-field">
                            <label class="form-label"
                                   for="notificationAudience">
                                訊息傳送對象
                                <span class="send-required" aria-hidden="true">*</span>
                            </label>

                            <select class="form-select send-notification-control"
                                    id="notificationAudience"
                                    required>
                                <option value="">請選擇傳送對象</option>
                                <option value="user"
                                        data-list="notificationUserAccounts"
                                        data-label="會員">
                                    會員
                                </option>
                                <option value="admin"
                                        data-list="notificationAdminAccounts"
                                        data-label="管理員">
                                    管理員
                                </option>
                            </select>

                            <div class="invalid-feedback">
                                請選擇訊息傳送對象。
                            </div>
                        </div>

                        <div class="send-notification-field is-hidden"
                             id="notificationAccountField">
                            <label class="form-label"
                                   for="notificationAccount">
                                帳號
                                <span class="send-required" aria-hidden="true">*</span>
                            </label>

                            <input class="form-control send-notification-control"
                                   id="notificationAccount"
                                   type="text"
                                   maxlength="50"
                                   placeholder="請先選擇傳送對象"
                                   autocomplete="off"
                                   required
                                   disabled>

                            <datalist id="notificationUserAccounts">
                                @foreach (var account in Model.UserAccounts)
                                {
                                    <option value="@account.Account"
                                            data-id="@account.Id"></option>
                                }
                            </datalist>

                            <datalist id="notificationAdminAccounts">
                                @foreach (var account in Model.AdminAccounts)
                                {
                                    <option value="@account.Account"
                                            data-id="@account.Id"></option>
                                }
                            </datalist>

                            <div class="invalid-feedback"
                                 id="notificationAccountFeedback">
                                請選擇清單中可發送的帳號。
                            </div>
                        </div>
                    </div>

                    <div class="send-notification-field">
                        <div class="send-notification-label-row">
                            <label class="form-label"
                                   for="notificationMessage">
                                通知內容
                                <span class="send-required" aria-hidden="true">*</span>
                            </label>

                            <span class="send-notification-counter"
                                  id="notificationMessageCounter"
                                  aria-live="polite">
                                0 / 100
                            </span>
                        </div>

                        <textarea class="form-control send-notification-message"
                                  id="notificationMessage"
                                  rows="10"
                                  maxlength="100"
                                  placeholder="請輸入要發送的訊息內容（最多 100 字）"
                                  required></textarea>

                        <div class="invalid-feedback">
                            請輸入 1 至 100 字的通知內容。
                        </div>
                    </div>

                    <div class="send-notification-actions">
                        <button class="member-create-open-btn"
                                id="sendNotificationSubmitButton"
                                type="submit">
                            <i class="bi bi-send me-1"></i>發送訊息
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
</div>

<div class="modal fade"
     id="sendNotificationConfirmModal"
     tabindex="-1"
     aria-labelledby="sendNotificationConfirmTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content member-form-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="sendNotificationConfirmTitle">
                    確認發送訊息
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="關閉"></button>
            </div>

            <div class="modal-body">
                <p class="send-confirm-text mb-3">
                    確定要將訊息傳送給
                    <strong id="sendConfirmTarget">—</strong>
                    嗎？
                </p>

                <div class="send-confirm-message"
                     id="sendConfirmMessage"></div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    取消
                </button>

                <button type="button"
                        class="btn btn-warning fw-bold text-brown"
                        id="sendNotificationConfirmButton">
                    <span data-send-idle>確定發送</span>
                    <span class="is-hidden" data-send-busy>
                        <span class="spinner-border spinner-border-sm me-1"
                              aria-hidden="true"></span>
                        發送中...
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/send-notification.css" rel="stylesheet" asp-append-version="true">
}

@section Scripts {
    <script src="~/js/send-notification.js" asp-append-version="true"></script>
}
